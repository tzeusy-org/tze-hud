    "publication_opacity": [
      "renderer/animation.rs update_publication_animations, pub_opacity, prune_faded_publications, animations_in_flight, next_animation_deadline",
      "renderer/zone_render.rs calls pub_opacity for notification backdrops",
      "renderer/text.rs calls pub_opacity for notification text"
    ],
    "idle_wake": [
      "public Compositor::next_animation_deadline -> runtime/windowed main-loop wake deadline; signature Option<Instant> retained",
      "existing idle_gate direct tests, caret/widget next-wake inputs retained"
    ]
  },
  "design_decision": "Use private explicit Instant *_at(now) state/predicate/read/deadline variants with existing methods delegating to real now; keep current crate-visible field and externally public method shapes. TestClock wall expiry and explicit phase Instant advance together in existing tests. No new public clock framework or speculative monotonic-to-Instant mapper is required."
