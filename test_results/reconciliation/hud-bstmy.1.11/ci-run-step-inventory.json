{
  "workflow_env": {
    "APT_OPTS": "-o Acquire::Retries=3 -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30",
    "CARGO_TERM_COLOR": "always",
    "RUST_BACKTRACE": 1,
    "HEADLESS_FORCE_SOFTWARE": "1"
  },
  "run_steps": [
    {
      "job": "check",
      "job_name": "cargo check",
      "step": 1,
      "name": "Test fullscreen vs overlay harness contract",
      "run": ".\\scripts\\ci\\windows\\test-windowed-fullscreen-overlay-perf.ps1",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "check",
      "job_name": "cargo check",
      "step": 4,
      "name": "Install protobuf compiler (required by tze_hud_protocol build script)",
      "run": "sudo apt-get $APT_OPTS update -q\nsudo apt-get $APT_OPTS install -y --no-install-recommends protobuf-compiler\n",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "check",
      "job_name": "cargo check",
      "step": 5,
      "name": "cargo check (workspace)",
      "run": "cargo check --workspace",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "check",
      "job_name": "cargo check",
      "step": 7,
      "name": "cargo machete (unused dependencies)",
      "run": "cargo machete",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "check",
      "job_name": "cargo check",
      "step": 8,
      "name": "Test idle-efficiency artifact gate",
      "run": "python3 scripts/ci/test_check_idle_efficiency.py",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "check",
      "job_name": "cargo check",
      "step": 9,
      "name": "Test quiescent-efficiency startup contract",
      "run": "python3 scripts/ci/test_run_quiescent_efficiency_script.py",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "fmt",
      "job_name": "cargo fmt",
      "step": 2,
      "name": "cargo fmt --check",
      "run": "cargo fmt --check",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "clippy",
      "job_name": "cargo clippy",
      "step": 3,
      "name": "Install protobuf compiler (required by tze_hud_protocol build script)",
      "run": "sudo apt-get $APT_OPTS update -q\nsudo apt-get $APT_OPTS install -y --no-install-recommends protobuf-compiler\n",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "clippy",
      "job_name": "cargo clippy",
      "step": 4,
      "name": "cargo clippy (workspace, all targets, deny warnings)",
      "run": "cargo clippy --workspace --all-targets -- -D warnings",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "clippy-windows-gnu",
      "job_name": "cargo clippy (windows-gnu cross-target)",
      "step": 3,
      "name": "Install protobuf compiler + MinGW cross toolchain",
      "run": "sudo apt-get $APT_OPTS update -q\nsudo apt-get $APT_OPTS install -y --no-install-recommends \\\n  protobuf-compiler \\\n  mingw-w64\n",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "clippy-windows-gnu",
      "job_name": "cargo clippy (windows-gnu cross-target)",
      "step": 4,
      "name": "cargo clippy (windows-gnu, cfg(windows) crates, deny warnings)",
      "run": "cargo clippy \\\n  -p tze_hud_runtime \\\n  -p tze_hud_compositor \\\n  -p tze_hud_config \\\n  --target x86_64-pc-windows-gnu \\\n  -- -D warnings\n",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "test-unit",
      "job_name": "cargo test (unit)",
      "step": 3,
      "name": "Install Mesa / llvmpipe + protobuf compiler",
      "run": "sudo apt-get $APT_OPTS update -q\nsudo apt-get $APT_OPTS install -y --no-install-recommends \\\n  libvulkan1 \\\n  mesa-vulkan-drivers \\\n  mesa-utils \\\n  libegl-mesa0 \\\n  libgl1-mesa-dri \\\n  protobuf-compiler\n",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "test-unit",
      "job_name": "cargo test (unit)",
      "step": 4,
      "name": "cargo test (workspace, exclude integration)",
      "run": "cargo test \\\n  --workspace \\\n  --all-targets \\\n  --exclude integration\n",
      "step_env": {
        "TZE_HUD_REQUIRE_GPU": "1"
      },
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "test-integration",
      "job_name": "cargo test (integration)",
      "step": 3,
      "name": "Install Mesa / llvmpipe + protobuf compiler",
      "run": "sudo apt-get $APT_OPTS update -q\nsudo apt-get $APT_OPTS install -y --no-install-recommends \\\n  libvulkan1 \\\n  mesa-vulkan-drivers \\\n  mesa-utils \\\n  libegl-mesa0 \\\n  libgl1-mesa-dri \\\n  protobuf-compiler\n",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "test-integration",
      "job_name": "cargo test (integration)",
      "step": 4,
      "name": "cargo test -p integration (headless suites)",
      "run": "cargo test -p integration --tests\n",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "test-integration",
      "job_name": "cargo test (integration)",
      "step": 5,
      "name": "Test token-footprint gate contract",
      "run": "python3 -m unittest scripts.ci.test_check_token_footprint scripts.ci.test_token_footprint_flow",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "test-integration",
      "job_name": "cargo test (integration)",
      "step": 6,
      "name": "Calibrate deterministic LLM-facing token footprint",
      "run": "mkdir -p test_results/token-footprint\ncargo run -p benchmark --features headless \\\n  --bin token_footprint_calibration -- \\\n  --output test_results/token-footprint/measurement.json\ncargo run -p benchmark --features headless \\\n  --bin token_footprint_calibration -- \\\n  --output test_results/token-footprint/repeat.json\ncmp test_results/token-footprint/measurement.json \\\n  test_results/token-footprint/repeat.json\npython3 scripts/ci/check_token_footprint.py \\\n  --measurement test_results/token-footprint/measurement.json \\\n  --baseline scripts/ci/token_footprint_baseline.json \\\n  --output test_results/token-footprint/gate-report.json\n",
      "step_env": {
        "HEADLESS_FORCE_SOFTWARE": "1"
      },
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "production-boot-vertical-slice",
      "job_name": "vertical_slice production config boot",
      "step": 3,
      "name": "Install Mesa / llvmpipe + protobuf compiler",
      "run": "sudo apt-get $APT_OPTS update -q\nsudo apt-get $APT_OPTS install -y --no-install-recommends \\\n  libvulkan1 \\\n  mesa-vulkan-drivers \\\n  mesa-utils \\\n  libegl-mesa0 \\\n  libgl1-mesa-dri \\\n  protobuf-compiler\n",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "production-boot-vertical-slice",
      "job_name": "vertical_slice production config boot",
      "step": 4,
      "name": "cargo test -p vertical_slice --test production_boot",
      "run": "cargo test \\\n  -p vertical_slice \\\n  --test production_boot \\\n  -- --nocapture\n",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "canonical-app-production-boot",
      "job_name": "canonical app production config boot gate",
      "step": 3,
      "name": "Install Mesa / llvmpipe + protobuf compiler",
      "run": "sudo apt-get $APT_OPTS update -q\nsudo apt-get $APT_OPTS install -y --no-install-recommends \\\n  libvulkan1 \\\n  mesa-vulkan-drivers \\\n  mesa-utils \\\n  libegl-mesa0 \\\n  libgl1-mesa-dri \\\n  protobuf-compiler\n",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "canonical-app-production-boot",
      "job_name": "canonical app production config boot gate",
      "step": 4,
      "name": "cargo test -p tze_hud_app --test production_boot",
      "run": "cargo test \\\n  -p tze_hud_app \\\n  --test production_boot \\\n  -- --nocapture\n",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "user-test-python-suite",
      "job_name": "user-test python suite",
      "step": 2,
      "name": "Install Python test dependencies",
      "run": "pip install --quiet -r scripts/requirements-dev.txt\n",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "user-test-python-suite",
      "job_name": "user-test python suite",
      "step": 3,
      "name": "Run pure-Python user-test suite",
      "run": "python3 -m pytest \\\n  .claude/skills/user-test/tests/ \\\n  .claude/skills/user-test/scripts/test_hud_grpc_client.py \\\n  scripts/tests/ \\\n  -q\n",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "user-test-python-suite",
      "job_name": "user-test python suite",
      "step": 4,
      "name": "Run scripts/ci unit tests",
      "run": "python3 -m unittest discover -s scripts/ci",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "dev-mode-guard",
      "job_name": "dev-mode guard (release build)",
      "step": 1,
      "name": "Verify dev-mode is not a default feature",
      "run": "cargo metadata --format-version 1 --no-deps | python3 scripts/ci/check_dev_mode_defaults.py",
      "step_env": {},
      "job_env": {},
      "continue_on_error": false
    },
    {
      "job": "test-gpu-pixel-readback",
      "job_name": "pixel readback (GPU / llvmpipe, informational)",
      "step": 3,
      "name": "Install Mesa / llvmpipe + Vulkan loader + protobuf compiler",
      "run": "sudo apt-get $APT_OPTS update -q\nsudo apt-get $APT_OPTS install -y --no-install-recommends \\\n  libvulkan1 \\\n  mesa-vulkan-drivers \\\n  mesa-utils \\\n  libegl-mesa0 \\\n  libgl1-mesa-dri \\\n  vulkan-tools \\\n  protobuf-compiler\n",
      "step_env": {},
      "job_env": {},
      "continue_on_error": true
    },
    {
      "job": "test-gpu-pixel-readback",
      "job_name": "pixel readback (GPU / llvmpipe, informational)",
      "step": 4,
      "name": "Verify Vulkan adapter available",
      "run": "vulkaninfo --summary 2>&1 | head -30 || true",
      "step_env": {},
      "job_env": {},
      "continue_on_error": true
    },
    {
      "job": "test-gpu-pixel-readback",
      "job_name": "pixel readback (GPU / llvmpipe, informational)",
      "step": 5,
      "name": "cargo test pixel_readback (software GPU)",
      "run": "cargo test \\\n  -p tze_hud_runtime \\\n  --test pixel_readback \\\n  --features dev-mode \\\n  -- --nocapture\n",
      "step_env": {
        "HEADLESS_FORCE_SOFTWARE": "1",
        "LLVMPIPE_CI": "1",
        "TZE_HUD_REQUIRE_GPU": "1"
      },
      "job_env": {},
      "continue_on_error": true
    }
  ]
}
